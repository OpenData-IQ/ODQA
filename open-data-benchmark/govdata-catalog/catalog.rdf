      <dcat:Dataset rdf:about="https://gdk.gdi-de.org/inspire/srv/eng/xml_iso19139?uuid=4a698e2a-fdba-3ef8-aa85-356b75083b85">
        <dct:title>3D-Gebäudemodelle im Level of Detail 1 (LoD 1)</dct:title>
        <dct:description>Der Datensatz enthält flächendeckend die dreidimensionalen Gebäudemodelle des Landes Berlin im Level of Detail 1 (LoD1). Die Grundrisse der Gebäudemodelle entsprechen genau den Gebäudeumringen, wie sie im Liegenschaftskataster nachgewiesen sind.</dct:description>
        <dct:identifier>4a698e2a-fdba-3ef8-aa85-356b75083b85</dct:identifier>
