        <dcat:keyword>open-data</dcat:keyword>
        <dcat:keyword>opendata</dcat:keyword>
        <dcat:keyword>roheitsdelikte</dcat:keyword>
        <dcat:keyword>sicherheit</dcat:keyword>
        <dcat:keyword>öffentlicher-raum</dcat:keyword>
