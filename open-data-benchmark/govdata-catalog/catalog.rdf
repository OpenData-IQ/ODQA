      <dcat:Dataset rdf:about="https://gdk.gdi-de.org/inspire/srv/eng/xml_iso19139?uuid=49525967-641f-428f-aecd-16d60b82e75f">
        <dct:title>Langjähriges Mittel der Lufttemperatur 1981-2010 (Umweltatlas)</dct:title>
        <dct:description>Langjährige Verteilung der mittleren Lufttemperaturen in 2 m Höhe in Berlin und dem näheren Umland (Gesamtjahr, Frühling, Sommer, Herbst, Winter). Die Berechnung des 30-jährigen Temperaturmittels erfolgte auf Grundlage der mittleren Monatswerte für den Zeitraum vom 01.01.1981 bis zum 31.12.2010.</dct:description>
        <dct:identifier>49525967-641f-428f-aecd-16d60b82e75f</dct:identifier>
        <dct:type rdf:resource="http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"/>
