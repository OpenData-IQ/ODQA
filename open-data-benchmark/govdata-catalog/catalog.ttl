<https://gdk.gdi-de.org/inspire/srv/eng/xml_iso19139?uuid=5363bbcd-d528-4747-9679-0ce08ea32cde> a dcat:Dataset ;
    dcatde:contributorID <http://dcat-ap.de/def/contributors/gdiDE> ;
    dct:accessRights <http://inspire.ec.europa.eu/metadata-codelist/LimitationsOnPublicAccess/noLimitations> ;
    dct:description "Die Gewaltdelinquenz unterteilt sich in drei Themen: - Jugendgewalt, - Innerfamiliäre u. partnerschaftliche Gewalt, - Rohheitsdelikte-Gesamt. Die Daten stammen aus dem Berliner Monitoring zur Gewaltdelinquenz und geben die erfassten Rohheitsdelikte in Form der Gewaltbelastung nach Standardabweichung auf Ebene der Lebensweltlich Orientierten Räume (LOR) wider. Der Aktualisierungszyklus beträgt 2 Jahre." ;
    dct:identifier "5363bbcd-d528-4747-9679-0ce08ea32cde" ;
    dct:issued "2023-10-31"^^xsd:date ;
    dct:language <http://publications.europa.eu/resource/authority/language/DEU> ;
    dct:modified "2025-08-08T10:16:31"^^xsd:dateTime ;
    dct:publisher [ a foaf:Agent ;
            foaf:mbox "albrechtlueter@camino-werkstatt.de" ;
            foaf:name "Arbeitsstelle Gewaltprävention i.A. der Landeskommission Berlin gegen Gewalt, Senatsverwaltung für Inneres und Sport" ] ;
    dct:spatial [ a dct:Location ;
            locn:geometry "POLYGON ((12.9709 52.6954, 13.8109 52.6954, 13.8109 52.3005, 12.9709 52.3005, 12.9709 52.6954))"^^gsp:wktLiteral ] ;
    dct:title "Monitoring Gewaltdelinquenz" ;
    dct:type <http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset> ;
    adms:identifier "5363bbcd-d528-4747-9679-0ce08ea32cde" ;
    dcat:contactPoint [ a vcard:Organization ;
            vcard:fn "Arbeitsstelle Gewaltprävention i.A. der Landeskommission Berlin gegen Gewalt, Senatsverwaltung für Inneres und Sport" ;
            vcard:hasEmail <mailto:albrechtlueter@camino-werkstatt.de> ;
            vcard:hasTelephone <tel:+49-30-610737220> ] ;
    dcat:distribution <https://gdi.berlin.de/services/wfs/gewaltdelinquenz?REQUEST=GetCapabilities&SERVICE=wfs#distribution> ;
    dcat:keyword "familie",
        "geodaten",
        "gewalt",
        "jugend",
        "open-data",
        "opendata",
        "roheitsdelikte",
        "sicherheit",
        "öffentlicher-raum" ;
    dcat:theme <http://publications.europa.eu/resource/authority/data-theme/EDUC>,
        <http://publications.europa.eu/resource/authority/data-theme/SOCI> .

