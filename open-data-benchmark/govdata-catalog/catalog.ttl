<https://gdk.gdi-de.org/inspire/srv/eng/xml_iso19139?uuid=558eed2a-2d05-4447-a580-e26e7dccd48a> a dcat:Dataset ;
    dcatde:contributorID <http://dcat-ap.de/def/contributors/gdiDE> ;
    dct:accessRights <http://inspire.ec.europa.eu/metadata-codelist/LimitationsOnPublicAccess/noLimitations> ;
    dct:accrualPeriodicity <http://publications.europa.eu/resource/authority/frequency/ANNUAL> ;
    dct:description """Darstellung der Bäume in den Liegenschaften der Grün Berlin GmbH und eines Teils der Bäume im Straßenraum im direkten Umfeld dieser Liegenschaften.

Datenquelle für den Anlagenbaumbestand der landeseigenen Grün Berlin GmbH im Geoportal ist das Baumkataster des Grünflächeninformations- und -managementsystems (GRIS) der Grün Berlin ? außerhalb des Bestandes des GRIS Berlin, in dem die Bäume und Grünflächen verwaltet werden, die sich in der Zuständigkeit der Grün Berlin GmbH befinden. Im Baumkataster der Grün Berlin sind etwa 25.000 aktive Bäume mit ihren Daten erfasst.""" ;
    dct:identifier "558eed2a-2d05-4447-a580-e26e7dccd48a" ;
    dct:issued "2024-04-04"^^xsd:date ;
    dct:language <http://publications.europa.eu/resource/authority/language/DEU> ;
    dct:modified "2025-08-08T10:16:32"^^xsd:dateTime ;
    dct:publisher [ a foaf:Agent ;
            foaf:mbox "gris@gruen-berlin.de" ;
            foaf:name "Senatsverwaltung für Stadtentwicklung, Bauen und Wohnen" ] ;
    dct:spatial [ a dct:Location ;
            locn:geometry "POLYGON ((13.0928 52.6688, 13.7501 52.6688, 13.7501 52.3454, 13.0928 52.3454, 13.0928 52.6688))"^^gsp:wktLiteral ] ;
    dct:title "Baumbestand in den Liegenschaften der Grün Berlin GmbH (Anlagenbäume)" ;
    dct:type <http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset> ;
    adms:identifier "558eed2a-2d05-4447-a580-e26e7dccd48a" ;
    dcat:contactPoint [ a vcard:Organization ;
            vcard:fn "Senatsverwaltung für Stadtentwicklung, Bauen und Wohnen" ;
            vcard:hasEmail <mailto:gris@gruen-berlin.de> ;
            vcard:hasTelephone <tel:+49-30-700906-700> ] ;
    dcat:distribution <https://gdi.berlin.de/services/wfs/baumbestand_gruen_berlin?REQUEST=GetCapabilities&SERVICE=wfs#distribution> ;
