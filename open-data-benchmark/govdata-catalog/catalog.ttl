    dct:spatial [ a dct:Location ;
            locn:geometry "POLYGON ((13.0790 52.6877, 13.7701 52.6877, 13.7701 52.3284, 13.0790 52.3284, 13.0790 52.6877))"^^gsp:wktLiteral ] ;
    dct:title "Sanierungsgebiete" ;
    dct:type <http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset> ;
